
<!DOCTYPE html>
<html>
<head>
    <title>Kalkulator Fotocopy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 20px;
            border-radius: 15px;
            max-width: 400px;
            margin: auto;
            box-shadow: 0 0 10px gray;
        }

        h2 {
            text-align: center;
            color: blue;
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            font-size: 16px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: blue;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
        }

        .hasil {
            margin-top: 20px;
            padding: 15px;
            background: #e8f5e9;
            border-radius: 10px;
        }
    </style>
</head>

<body>

<div class="container">

<h2>Program Fotocopy</h2>

<p>Masukkan jumlah lembar fotocopy:</p>

<input type="number" id="lembar" placeholder="Contoh: 168">

<button onclick="hitung()">Hitung Harga</button>


<div class="hasil" id="hasil">
    Hasil akan muncul di sini
</div>


</div>


<script>

function hitung(){

    let jumlah = document.getElementById("lembar").value;

    let harga;
    let total;


    if(jumlah < 100){
        harga = 150;
    }
    else if(jumlah <= 200){
        harga = 100;
    }
    else{
        harga = 80;
    }


    total = jumlah * harga;


    document.getElementById("hasil").innerHTML =
    "Jumlah lembar : " + jumlah + " lembar <br>" +
    "Harga per lembar : Rp " + harga + 
    "<br>Total bayar : Rp " + total;

}

</script>


</body>
</html>
